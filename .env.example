# Export this in your shell. The application does not automatically load .env.
GH_AI_TOKEN=

# Inference key for optional Vultr songs; loaded from the server environment.
VULTR_INFERENCE_API_KEY=

# Production planning (comma-separated backups, tried in order; never commit real keys)
SERPAPI_API_KEY=
SERPAPI_BACKUP_KEYS=
STORYFORGE_SEARCH_DAILY_LIMIT=10
# Google OAuth web client; register http://127.0.0.1:8766/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional existing OAuth credentials instead of the browser connection
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Optional unified studio settings
STORYFORGE_GITHUB_TOKEN=
# Additional owner/repo values, comma-separated (main repo is always included)
STORYFORGE_RUNNER_REPOS=
# STORYFORGE_WORKSPACE=absolute/path/to/repository
